# Server
NODE_ENV=development
PORT=5050

# Database
MONGO_URI=mongodb://localhost:27017/expresso-portal

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — URL of the frontend that is allowed to call this API
FRONTEND_URL=http://localhost:3000

# Reverse proxies in front of the API (Render/nginx). Default: 1 in production.
TRUST_PROXY=1

# Public base URL of this API (used for local file links)
API_PUBLIC_URL=http://localhost:5050

# Google Sign-In (optional) — must match the client's REACT_APP_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Email (invites, password reset). Without SMTP, emails are only logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Expresso Portal <no-reply@example.com>"

# AWS S3 uploads
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Private documents (client files, CVs). Block Public Access ON. See docs/storage.md
AWS_S3_PRIVATE_BUCKET=your-private-bucket

# Super admin seed (used by scripts/seedUser.js)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Super Admin
